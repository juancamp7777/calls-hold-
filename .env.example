# ---------- Obligatorio ----------
# Token de @BotFather en Telegram
TELEGRAM_TOKEN=
# Clave de Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Tu chat_id: arranca el bot, escríbele /miid y pega aquí el número
OWNER_CHAT_ID=

# ---------- Sobre ti ----------
NOMBRE_DUENO=Juan
CONTEXTO="Desarrollador full stack. Proyectos: ... Stack: ... Horario: lunes a viernes 8am-6pm."

# ---------- Claude ----------
MODELO_CLAUDE=claude-opus-5-5
# low (rápido) | medium | high
ESFUERZO_CLAUDE=low

# ---------- Voz (opcional) ----------
