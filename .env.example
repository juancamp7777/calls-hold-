# ---------- Obligatorio ----------
# Token de @BotFather en Telegram
TELEGRAM_TOKEN=
# Clave de Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Tu chat_id: arranca el bot, escríbele /miid y pega aquí el número
OWNER_CHAT_ID=

# ---------- Sobre ti ----------
NOMBRE_DUENO=Juan
CONTEXTO="Desarrollador full stack. Proyectos: ... Stack: ... Horario: lunes a viernes 8am-6pm."

# ---------- Claude ----------
MODELO_CLAUDE=claude-opus-5-5
# low (rápido) | medium | high
ESFUERZO_CLAUDE=medium

# ---------- Voz (opcional) ----------
# Sin esta clave el bot solo atiende texto
OPENAI_API_KEY=
RESPONDER_CON_VOZ=si
VOZ=coral

# ---------- Llamadas (Twilio) ----------
# Auth Token de tu cuenta Twilio (Console > Account Info). Sirve para verificar que las llamadas vienen de Twilio.
TWILIO_AUTH_TOKEN=
MAX_MINUTOS_LLAMADA=10

# ---------- Servidor ----------
# En Railway, con un volumen montado en /data, para que los tickets no se borren
DB_PATH=asistente.db
ZONA_HORARIA=America/Bogota
